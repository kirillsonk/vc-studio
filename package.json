    "test:node": "node scripts/test-node-runtime.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "lint": "npm run check:copy && npm run typecheck"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
