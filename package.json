    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "^8.23.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.28"
