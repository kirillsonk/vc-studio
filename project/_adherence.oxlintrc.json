{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/demo/**",
              "components/forms/**",
              "components/intake/**",
              "components/numbers/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest))/i]",
        "message": "Font not provided by the design system. Available: Onest."
      },
      {
        "selector": "JSXOpeningElement[name.name='BriefComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSend|disabled|style|key|ref|className|style|children)$/]",
        "message": "<BriefComposer> doesn't accept that prop. Declared props: placeholder, value, onChange, onSend, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BriefMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|index|pending|children|style|key|ref|className|style|children)$/]",
        "message": "<BriefMessage> doesn't accept that prop. Declared props: role, index, pending, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BriefMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:ai|user)$/]",
        "message": "<BriefMessage> role must be one of 'ai' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|loading|icon|iconRight|full|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, loading, icon, iconRight, full, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kind|year|client|days|budget|media|ratio|href|onClick|size|style|key|ref|className|style|children)$/]",
        "message": "<CaseCard> doesn't accept that prop. Declared props: title, kind, year, client, days, budget, media, ratio, href, onClick, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<CaseCard> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Compare'] > JSXAttribute > JSXIdentifier[name!=/^(?:ours|theirs|ourLabel|theirLabel|unit|savingLabel|note|style|key|ref|className|style|children)$/]",
        "message": "<Compare> doesn't accept that prop. Declared props: ours, theirs, ourLabel, theirLabel, unit, savingLabel, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|from|duration|decimals|prefix|suffix|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: value, from, duration, decimals, prefix, suffix, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|sm)$/]",
        "message": "<Counter> size must be one of 'xl' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|positive|brand|muted|inverse)$/]",
        "message": "<Counter> tone must be one of 'ink' | 'positive' | 'brand' | 'muted' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|poster|ratio|cta|autoload|loadingText|dark|children|onStart|style|key|ref|className|style|children)$/]",
        "message": "<DemoBlock> doesn't accept that prop. Declared props: title, meta, poster, ratio, cta, autoload, loadingText, dark, children, onStart, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EstimatePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:scope|term|budget|status|onConfirm|confirmLabel|style|key|ref|className|style|children)$/]",
        "message": "<EstimatePanel> doesn't accept that prop. Declared props: scope, term, budget, status, onConfirm, confirmLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EstimatePanel'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:empty|thinking|building|ready)$/]",
        "message": "<EstimatePanel> status must be one of 'empty' | 'thinking' | 'building' | 'ready'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|htmlFor|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, required, htmlFor, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ledger'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|rows|total|totalLabel|note|dense|style|key|ref|className|style|children)$/]",
        "message": "<Ledger> doesn't accept that prop. Declared props: title, rows, total, totalLabel, note, dense, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|onClick|meta|children|style|key|ref|className|style|children)$/]",
        "message": "<OptionBlock> doesn't accept that prop. Declared props: selected, disabled, onClick, meta, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|disabled|options|placeholder|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: error, disabled, options, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|tone|size|animate|prefix|suffix|decimals|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, note, tone, size, animate, prefix, suffix, decimals, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|positive|brand|inverse)$/]",
        "message": "<Stat> tone must be one of 'ink' | 'positive' | 'brand' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|sm)$/]",
        "message": "<Stat> size must be one of 'xl' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|ink)$/]",
        "message": "<Tag> tone must be one of 'default' | 'brand' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|disabled|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: error, disabled, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|disabled|prefix|suffix|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: error, disabled, prefix, suffix."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trace'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|active|labels|vertical|style|key|ref|className|style|children)$/]",
        "message": "<Trace> doesn't accept that prop. Declared props: steps, active, labels, vertical, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
