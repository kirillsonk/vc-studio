# Public business contacts, embedded at build time. Leave unverified values empty.
NEXT_PUBLIC_STUDIO_EMAIL=
# Username without @ or URL
NEXT_PUBLIC_STUDIO_TELEGRAM=

# Production build defaults to the same-origin Worker
NEXT_PUBLIC_INTAKE_API_URL=/api/intake
# Keep delivery disabled until Telegram and the operator policy are ready
NEXT_PUBLIC_INTAKE_DELIVERY_ENABLED=false
NEXT_PUBLIC_PRIVACY_URL=

# SERVER SECRET ONLY. Already configured in Sites, not available to local builds
CHATGPT_PLATFORM_API_KEY=
